// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  tasks                Task[]
  notes                Note[]
  daySummaries         DaySummary[]
  habits               Habit[]
  habitCompletions     HabitCompletion[]
  chatMessages         ChatMessage[]
  notifications        Notification[]
  emailPreference      EmailPreference?
  lastEmailSent    DateTime?
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  priority Priority  @default(MEDIUM)
  dueDate  DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  color     String? // keep this ✔
  pinned    Boolean  @default(false) // keep this ✔
  category  String? // ⭐ NEW field for folders/categories
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model DaySummary {
  id           Int      @id @default(autoincrement())
  date         DateTime
  mood         String? // "good", "moderate", "bad"
  productivity Int? // 1–5
  journal      String? // Optional daily notes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([userId, date])
}

model Habit {
  id        Int      @id @default(autoincrement())
  name      String
  color     String? // e.g. "emerald", "rose", "sky"
  icon      String? // e.g. "🔥", "📚"
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  completions HabitCompletion[]
}

model HabitCompletion {
  id        Int      @id @default(autoincrement())
  date      DateTime // normalized to start-of-day (UTC) for uniqueness
  createdAt DateTime @default(now())

  habit   Habit @relation(fields: [habitId], references: [id])
  habitId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([userId, habitId, date]) // one completion per habit per day
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  content   String
  role      String   // "user" or "assistant"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String   // "task_overdue", "streak_warning", "daily_briefing", "custom"
  read      Boolean  @default(false)
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model EmailPreference {
  id              Int      @id @default(autoincrement())
  dailyBriefing   Boolean  @default(true)
  weeklyReport    Boolean  @default(false)
  taskReminders   Boolean  @default(true)
  streakAlerts    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int      @unique
}
